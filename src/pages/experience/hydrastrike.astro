---
import Layout from '../../layouts/Layout.astro';

const callouts = [
  {
    idx: '01',
    title: 'Versatile upper payload deck',
    body: 'Houses FPV drones, EW modules, and buoyant relay sensors, swapped between missions without touching the hull.',
    chip: 'FPV · EW · ISR',
    side: 'right',
  },
  {
    idx: '02',
    title: 'Adaptive sensor and comms mast',
    body: 'Thermal and EO optics keep eyes on the target after the Spiders deploy, so the engagement can be re-tasked mid-mission.',
    chip: 'Thermal · EO · Datalink',
    side: 'right',
  },
  {
    idx: '03',
    title: 'Mission-flexible lower bay',
    body: 'Carries three kinetic Spiders or two lightweight torpedoes, released underway and independently guided.',
    chip: '3 Spiders · 2 LWT',
    side: 'left',
  },
];

const stats = [
  { value: 52, suffix: '%', label: 'of the Mk 48 ordnance, same lethality' },
  { value: 86, suffix: ' NM', label: 'operational range, three times the Mk 48' },
  { value: 6, prefix: 'TRL ', label: 'prototype tested in a relevant environment' },
  { value: 180, suffix: '+', label: 'stakeholder interviews across the fleet' },
];

const traction = [
  { k: '$100K', v: 'Equity-free funding from the Defense Innovation Unit.' },
  { k: 'CRADA', v: 'Cooperative research agreement signed with the U.S. Navy.' },
  { k: 'Big 5', v: 'Teaming agreement with a top-five defense prime.' },
  { k: '20 / 30', v: 'Admirals and acquisition officers interviewed directly.' },
];
---

<Layout
  title="SpiderEgg by Hydra Strike — Breno Casciello"
  description="A modular unmanned underwater vehicle that delivers Mk 48 class lethality using 52% of the ordnance. Built at Stanford, funded by the Defense Innovation Unit."
  theme="dark"
>
  <link slot="head" rel="preload" href="/fullassy0.5.glb" as="fetch" crossorigin="anonymous" />

  <a href="/" class="back-link" id="back-link">← Back</a>

  <!-- ══ Cinematic block: hero + pinned 3-D viewer ══ -->
  <div class="cinema">
    <div class="ocean" aria-hidden="true">
      <div class="rays"></div>
      <div class="vignette"></div>
    </div>

    <section class="hero">
      <div class="hero-inner">
        <div class="hero-eyebrow">Defense Innovation Unit · Hacking for Defense</div>
        <h1>SpiderEgg</h1>
        <div class="hero-by">by Hydra Strike</div>
        <p class="hero-sub">
          A modular unmanned underwater vehicle engineered to deliver distributed
          undersea effects at a fraction of the ordnance and cost of legacy
          heavyweight torpedoes.
        </p>

        <ul class="statstrip">
          {stats.map((s) => (
            <li>
              <span
                class="stat-val"
                data-count={s.value}
                data-prefix={s.prefix ?? ''}
                data-suffix={s.suffix ?? ''}
              >{s.prefix ?? ''}0{s.suffix ?? ''}</span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="scroll-cue" aria-hidden="true">
        <span>Scroll to explore the vehicle</span>
        <i></i>
      </div>
    </section>

    <div class="viewer-wrap" id="viewer">
      <canvas id="three-canvas"></canvas>

      <svg id="callout-svg" aria-hidden="true">
        {callouts.map((_, i) => (
          <g class="lead-g" data-i={i}>
            <path class="lead-line" data-i={i} />
            <circle class="lead-dot-halo" data-i={i} r="11" />
            <circle class="lead-dot" data-i={i} r="3.5" />
          </g>
        ))}
      </svg>

      <div class="callouts" aria-hidden="true">
        {callouts.map((c, i) => (
          <article class="callout" data-i={i} data-side={c.side}>
            <div class="c-head">
              <span class="c-idx">{c.idx}</span>
              <h4>{c.title}</h4>
            </div>
            <p>{c.body}</p>
            <span class="c-chip">{c.chip}</span>
          </article>
        ))}
      </div>

      <div class="loader" id="loader">
        <div class="loader-bar"><i id="loader-fill"></i></div>
        <span>Loading assembly</span>
      </div>

      <div class="viewer-progress" aria-hidden="true"><i id="vp-fill"></i></div>
    </div>

    <div class="scroll-driver"></div>
  </div>

  <!-- Shown instead of the pinned viewer when WebGL is unavailable or the
       visitor asked for reduced motion. -->
  <section class="viewer-fallback" id="viewer-fallback" hidden>
    <img src="/hs/vehicle-still.jpg" alt="The SpiderEgg vehicle rendered underwater" width="1600" height="833" />
    <ul>
      {callouts.map((c) => (
        <li>
          <span class="c-idx">{c.idx}</span>
          <div>
            <h4>{c.title}</h4>
            <p>{c.body}</p>
            <span class="c-chip">{c.chip}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ══ Content ══ -->
  <main>
    <section class="col reveal">
      <h2 class="section-label">Overview</h2>
      <h3 class="section-title">One hull, three effects</h3>
      <p>
        SpiderEgg is a modular UUV that carries three small kinetic effectors,
        the Spiders, in a lower payload bay, and an upper deck for FPV drones,
        EW modules, or sensor pods. It is built around commercial off the shelf
        components so it can be mass produced, and it launches from submarine
        torpedo tubes, surface vessels, or shore.
      </p>
      <p>
        My work covered the vehicle architecture, the hull and nose hydrodynamics,
        the payload bay release mechanism, and the simulation campaign that
        validated the core physics.
      </p>
    </section>

    <!-- CFD panel, full bleed and dark so the data reads as data -->
    <section class="cfd-band reveal">
      <div class="cfd-inner">
        <div class="cfd-copy">
          <h2 class="section-label on-dark">The core idea</h2>
          <h3 class="section-title on-dark">Energetic coupling</h3>
          <p>
            The three Spiders coordinate their terminal detonations in time and
            space. Their gas bubbles grow into each other, and the hydrodynamic
            interaction between them amplifies the combined blast well beyond
            the sum of the parts.
          </p>
          <p>
            Simulated and validated with Stanford's Flow Physics and
            Computational Engineering Lab, the effect reaches lethality
            equivalent to the Mk&nbsp;48, the Navy's only heavyweight torpedo
            option, using 52% of the ordnance.
          </p>
        </div>

        <figure class="cfd-figure" id="cfd">
          <div class="cfd-frame">
            <div class="cfd-sprite" id="cfd-sprite"></div>
            <div class="cfd-hud">
              <span class="cfd-tag">Liquid volume fraction</span>
              <span class="cfd-time" id="cfd-time">Frame 1 / 33</span>
            </div>
            <div class="cfd-scrub"><i id="cfd-fill"></i></div>
          </div>
          <figcaption>
            Two coupled charges. The bubbles expand, merge, and drive the free
            surface above them. Scroll to play the sequence.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Traction -->
    <section class="col reveal">
      <h2 class="section-label">Traction</h2>
      <h3 class="section-title">Built with the customer in the room</h3>
      <p>
        Over 180 stakeholder interviews, including 20 admirals and 30 acquisition
        officers, shaped the requirements before the first part was cut. That
        work turned into funding, a research agreement, and an industry partner.
      </p>
      <ul class="traction">
        {traction.map((t) => (
          <li>
            <span class="t-key">{t.k}</span>
            <span class="t-val">{t.v}</span>
          </li>
        ))}
      </ul>
    </section>
    <!-- Prototype photo, full bleed -->
    <figure class="shot reveal">
    <img
      src="/hs/prototype.jpg"
      alt="The 1:3 scale SpiderEgg prototype hull, assembled on a stand"
      loading="lazy"
      width="2000"
      height="599"
    />
    <figcaption>
      <span>1:3 scale prototype</span>
      Printed, sanded, and assembled in the lab, then tested in a relevant
      environment to close TRL&nbsp;6.
      </figcaption>
    </figure>

  </main>

  <footer class="closing">
    <div class="closing-inner">
      <p class="status">Hydra Strike has been archived.</p>
      <p class="further">
        Featured in Hacking for Defense.
        <a href="https://www.h4d.us/success-stories/team-skyshield-crgwl-hgymy" target="_blank" rel="noopener">Read the write-up →</a>
      </p>
      <a href="/" class="closing-back">← Back to all work</a>
    </div>
  </footer>
</Layout>

<style>
  /* ═══ Tokens ═══ */
  :root {
    --ink: #fff;
    --body: rgba(255, 255, 255, 0.68);
    --muted: rgba(255, 255, 255, 0.42);
    --hair: rgba(255, 255, 255, 0.13);
    --deep-0: #061019;
    --deep-1: #0a2436;
    --deep-2: #10394f;
    --surface-light: #7fc4dd;
    --accent: #6fd3e8;
  }

  .back-link {
    position: fixed;
    top: 2rem;
    left: 2.5rem;
    z-index: 200;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.25s ease;
    mix-blend-mode: difference;
  }
  .back-link:hover { color: #fff; }

  /* ═══ Cinematic block ═══ */
  .cinema {
    position: relative;
    background: var(--deep-0);
  }

  /* Sticky so the water stays put across the whole pinned sequence.
     The negative margin keeps it out of the layout flow. */
  .ocean {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    overflow: hidden;
    background:
      radial-gradient(120% 70% at 50% -15%, #2b7b9e 0%, rgba(43, 123, 158, 0) 58%),
      linear-gradient(180deg, #0a2f45 0%, #082334 40%, #051520 75%, #030a11 100%);
    pointer-events: none;
  }

  .rays {
    position: absolute;
    inset: -25% -15% -10%;
    background:
      linear-gradient(101deg, transparent 42%, rgba(150, 225, 255, 0.10) 46%, transparent 50%),
      linear-gradient(96deg, transparent 55%, rgba(150, 225, 255, 0.07) 59%, transparent 64%),
      linear-gradient(107deg, transparent 22%, rgba(150, 225, 255, 0.06) 27%, transparent 31%);
    filter: blur(22px);
    mix-blend-mode: screen;
    animation: drift 19s ease-in-out infinite alternate;
  }

  @keyframes drift {
    from { transform: translateX(-2.5%) scaleY(1); opacity: 0.85; }
    to   { transform: translateX(2.5%) scaleY(1.06); opacity: 1; }
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 65% at 50% 45%, transparent 30%, rgba(2, 8, 14, 0.75) 100%);
  }

  /* ═══ Hero ═══ */
  .hero {
    position: relative;
    z-index: 3;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 7rem 2.5rem 3rem;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .hero-inner { max-width: 720px; }

  .hero-eyebrow {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--surface-light);
    margin-bottom: 1.6rem;
    opacity: 0;
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s forwards;
  }

  .hero h1 {
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    color: #fff;
    margin: 0;
    line-height: 0.98;
    opacity: 0;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s forwards;
  }

  .hero-by {
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.42);
    margin: 0.7rem 0 1.8rem;
    opacity: 0;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s forwards;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.75;
    margin: 0 0 3rem;
    max-width: 560px;
    opacity: 0;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.45s forwards;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .statstrip {
    list-style: none;
    margin: 0;
    padding: 2rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    max-width: 720px;
    opacity: 0;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.6s forwards;
  }

  .stat-val {
    display: block;
    font-size: 1.9rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: #fff;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .stat-label {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.7rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.42);
  }

  .scroll-cue {
    position: relative;
    margin-top: auto;
    padding-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.34);
    opacity: 0;
    animation: rise 1s ease 1s forwards;
  }

  .scroll-cue i {
    display: block;
    width: 46px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
    position: relative;
    overflow: hidden;
  }

  .scroll-cue i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: sweep 2.4s ease-in-out infinite;
  }

  @keyframes sweep {
    0%   { transform: translateX(-100%); }
    60%  { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }

  /* ═══ Viewer ═══ */
  .viewer-wrap {
    position: sticky;
    top: 0;
    z-index: 2;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  #three-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  #three-canvas.ready { opacity: 1; }

  #callout-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .lead-line {
    fill: none;
    stroke: rgba(180, 235, 255, 0.55);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lead-dot { fill: var(--accent); }

  .lead-dot-halo {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.35;
  }

  .callouts {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .callout {
    position: absolute;
    top: 0;
    left: 0;
    width: min(340px, 32vw);
    opacity: 0;
    will-change: transform, opacity;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .callout[data-side='left'] { text-align: right; }

  .c-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid rgba(180, 235, 255, 0.22);
  }

  .callout[data-side='left'] .c-head { flex-direction: row-reverse; }

  .c-idx {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .callout h4 {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.35;
  }

  .callout p {
    margin: 0.7rem 0 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.62);
  }

  .c-chip {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.28rem 0.6rem;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(180, 235, 255, 0.85);
    border: 1px solid rgba(180, 235, 255, 0.22);
    border-radius: 2px;
  }

  .loader {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    transition: opacity 0.5s ease;
  }
  .loader.done { opacity: 0; pointer-events: none; }

  .loader-bar {
    width: 130px;
    height: 1px;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }
  .loader-bar i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width 0.25s ease;
  }

  .viewer-progress {
    position: absolute;
    left: 2.5rem;
    right: 2.5rem;
    bottom: 2rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }
  .viewer-progress i {
    display: block;
    height: 100%;
    width: 0%;
    background: rgba(180, 235, 255, 0.75);
  }

  .scroll-driver { height: 480vh; position: relative; z-index: 1; }

  /* ═══ Static fallback ═══ */
  .viewer-fallback {
    position: relative;
    z-index: 5;
    background: var(--deep-0);
    padding: 0 0 4rem;
  }
  .viewer-fallback[hidden] { display: none; }

  /* Feather the top edge so the still blends into the CSS water above it
     instead of showing a hard seam. */
  .viewer-fallback img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 14%);
  }

  .viewer-fallback ul {
    list-style: none;
    max-width: 660px;
    margin: 2.5rem auto 0;
    padding: 0 2.5rem;
    display: grid;
    gap: 2rem;
  }

  .viewer-fallback li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .viewer-fallback h4 {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .viewer-fallback p {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
  }

  /* When the fallback takes over, the pinned sequence must not reserve space
     and nothing should invite the visitor to scroll through it. */
  .no-3d .viewer-wrap,
  .no-3d .scroll-driver,
  .no-3d .scroll-cue { display: none; }

  .no-3d .ocean { margin-bottom: -100vh; }

  /* ═══ Content ═══ */
  main {
    position: relative;
    z-index: 5;
    background: var(--deep-0);
  }

  /* Reading column. Full-bleed blocks sit as siblings without this class. */
  .col {
    max-width: 660px;
    margin: 0 auto;
    padding: 5rem 2.5rem 0;
  }

  main > *:last-child { padding-bottom: 5rem; }

  .section-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 2rem;
  }

  main p {
    font-size: 0.925rem;
    color: var(--body);
    line-height: 1.8;
    margin: 0 0 1.4rem;
  }

  /* ═══ CFD ═══ */
  .cfd-band {
    margin-top: 6rem;
    padding: 5.5rem 2.5rem;
    background:
      radial-gradient(90% 80% at 20% 0%, #0d2c3f 0%, rgba(13, 44, 63, 0) 60%),
      #061019;
  }

  .cfd-inner {
    max-width: 1020px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .cfd-copy p {
    color: rgba(255, 255, 255, 0.62);
  }

  .section-label.on-dark { color: var(--surface-light); }
  .section-title.on-dark { color: #fff; }

  .cfd-figure { margin: 0; }

  .cfd-frame {
    position: relative;
    background: #030a11;
    border: 1px solid rgba(180, 235, 255, 0.14);
    border-radius: 3px;
    overflow: hidden;
  }

  .cfd-sprite {
    width: 100%;
    aspect-ratio: 420 / 416;
    background-image: url('/hs/cfd-sheet.png');
    background-repeat: no-repeat;
    background-size: 600% 600%;
    background-position: 0% 0%;
  }

  .cfd-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1rem 1.1rem;
    background: linear-gradient(180deg, transparent, rgba(4, 10, 16, 0.85));
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .cfd-time {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cfd-band figcaption { color: rgba(255, 255, 255, 0.45); }

  .cfd-scrub {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.14);
  }
  .cfd-scrub i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
  }

  figcaption {
    margin-top: 0.9rem;
    font-size: 0.76rem;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ═══ Traction ═══ */
  .traction {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
  }

  .traction li {
    background: #0a2030;
    padding: 1.5rem 1.4rem;
  }

  .t-key {
    display: block;
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .t-val {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--body);
  }

  /* ═══ Full-bleed photo ═══ */
  /* Padding, not margin: a margin here collapses out of .main and lets the
     dark body background show through as a band. */
  .shot {
    position: relative;
    z-index: 5;
    background: var(--deep-0);
    margin: 0;
    padding-top: 5rem;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot figcaption {
    max-width: 660px;
    margin: 0.9rem auto 0;
    padding: 0 2.5rem;
  }

  .shot figcaption span {
    display: block;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  /* ═══ Specs ═══ */
  /* ═══ Closing ═══ */
  .closing {
    position: relative;
    z-index: 5;
    background: var(--deep-0);
    padding: 5rem 2.5rem 6rem;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .closing-inner { max-width: 660px; margin: 0 auto; }

  .closing .status {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.875rem;
    margin: 0 0 0.8rem;
  }

  .closing .further {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
    margin: 0 0 2.5rem;
  }

  .closing .further a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(111, 211, 232, 0.3);
    padding-bottom: 1px;
    transition: border-color 0.2s ease;
  }
  .closing .further a:hover { border-color: var(--accent); }

  .closing-back {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .closing-back:hover { color: #fff; }

  /* ═══ Reveals ═══ */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
                transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .reveal.in { opacity: 1; transform: none; }

  /* ═══ Responsive ═══ */
  @media (max-width: 860px) {
    .statstrip { grid-template-columns: repeat(2, 1fr); gap: 1.4rem 1.2rem; }
    .traction { grid-template-columns: 1fr; }
    .hero { padding: 6rem 1.5rem 2.5rem; }
    .col { padding-left: 1.5rem; padding-right: 1.5rem; }
    .cfd-band { padding: 4rem 1.5rem; margin-top: 4rem; }
    .cfd-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .shot figcaption { padding: 0 1.5rem; }
    .closing { padding-left: 1.5rem; padding-right: 1.5rem; }
    .back-link { top: 1.2rem; left: 1.5rem; }
    .viewer-progress { left: 1.5rem; right: 1.5rem; bottom: 1.2rem; }

    #callout-svg { display: none; }

    .callout {
      width: auto;
      left: 1.2rem;
      right: 1.2rem;
      bottom: 3.2rem;
      top: auto;
      text-align: left !important;
      transform: none !important;
      padding: 1rem 1.1rem;
      background: rgba(6, 16, 25, 0.78);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(180, 235, 255, 0.16);
      border-radius: 4px;
    }
    .callout[data-side='left'] .c-head { flex-direction: row; }
    .scroll-driver { height: 380vh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rays, .scroll-cue i::after { animation: none; }
    .hero-eyebrow, .hero h1, .hero-by, .hero-sub, .statstrip, .scroll-cue {
      opacity: 1;
      animation: none;
    }
    .reveal { opacity: 1; transform: none; transition: none; }
    .scroll-driver { height: 100vh; }
  }
</style>

<script>
  import type * as THREE_NS from 'three';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = () => window.innerWidth <= 860;

  function webglAvailable() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  // A scroll-pinned camera move is exactly what reduced-motion asks us not to
  // do, so that preference takes the still image too.
  const use3D = webglAvailable() && !reduced;

  if (!use3D) {
    document.querySelector('.cinema')!.classList.add('no-3d');
    document.getElementById('viewer-fallback')!.removeAttribute('hidden');
  }

  /* ───────────────────────── 3-D viewer ─────────────────────────
     Wrapped so a machine without WebGL still gets the counters, reveals and
     simulation scrubber below instead of a dead module. */
  async function init3D() {
  // Loaded on demand so the 600 kB of three.js never reaches a visitor who
  // gets the still image instead.
  const THREE = await import('three');
  const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
  const { DRACOLoader } = await import('three/examples/jsm/loaders/DRACOLoader.js');

  const canvas = document.getElementById('three-canvas') as HTMLCanvasElement;
  const svgEl = document.getElementById('callout-svg') as unknown as SVGSVGElement;
  const loaderEl = document.getElementById('loader')!;
  const loaderFill = document.getElementById('loader-fill')!;
  const vpFill = document.getElementById('vp-fill')!;
  const cardEls = Array.from(document.querySelectorAll('.callout')) as HTMLElement[];
  const lineEls = Array.from(document.querySelectorAll('.lead-line')) as SVGPathElement[];
  const dotEls = Array.from(document.querySelectorAll('.lead-dot')) as SVGCircleElement[];
  const haloEls = Array.from(document.querySelectorAll('.lead-dot-halo')) as SVGCircleElement[];
  const groupEls = Array.from(document.querySelectorAll('.lead-g')) as SVGGElement[];

  let W = window.innerWidth;
  let H = window.innerHeight;

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile() ? 1.5 : 2));
  renderer.setSize(W, H);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.0;

  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x0a2233, 0.13);

  const camera = new THREE.PerspectiveCamera(38, W / H, 0.01, 100);
  const camPos = new THREE.Vector3(0.55, 0.42, 3.6);
  const camLook = new THREE.Vector3(0, 0, 0);
  const camPosTarget = camPos.clone();
  const camLookTarget = camLook.clone();

  /* Environment: a vertical ocean gradient, prefiltered for PBR reflections. */
  function buildEnvironment() {
    const c = document.createElement('canvas');
    c.width = 16;
    c.height = 128;
    const ctx = c.getContext('2d')!;
    const g = ctx.createLinearGradient(0, 0, 0, 128);
    g.addColorStop(0.0, '#dff4ff');
    g.addColorStop(0.22, '#8fd0e8');
    g.addColorStop(0.45, '#2d7ea0');
    g.addColorStop(0.72, '#123a52');
    g.addColorStop(1.0, '#04101a');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 16, 128);
    const tex = new THREE.CanvasTexture(c);
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.colorSpace = THREE.SRGBColorSpace;
    const pmrem = new THREE.PMREMGenerator(renderer);
    const rt = pmrem.fromEquirectangular(tex);
    tex.dispose();
    pmrem.dispose();
    return rt.texture;
  }
  scene.environment = buildEnvironment();

  /* Lights: sun from the surface, cold rim from below-behind. */
  const key = new THREE.DirectionalLight(0xdff0ff, 2.6);
  key.position.set(2.5, 6, 3);
  scene.add(key);

  const rim = new THREE.DirectionalLight(0x5fc0e0, 2.0);
  rim.position.set(-4, -1.5, -3.5);
  scene.add(rim);

  // Front fill keeps the hull readable against the dark water. Kept low so
  // the tail cone does not blow out into a white smear.
  const fill = new THREE.DirectionalLight(0xa8d8ee, 0.5);
  fill.position.set(1.5, 0.5, 4);
  scene.add(fill);

  scene.add(new THREE.HemisphereLight(0x9fd8f0, 0x0b2233, 1.2));

  /* Marine snow: slow drifting particles for depth cues. */
  const SNOW = reduced ? 0 : 520;
  let snow: THREE_NS.Points | null = null;
  if (SNOW) {
    const pos = new Float32Array(SNOW * 3);
    const spd = new Float32Array(SNOW);
    for (let i = 0; i < SNOW; i++) {
      pos[i * 3] = (Math.random() - 0.5) * 6;
      pos[i * 3 + 1] = (Math.random() - 0.5) * 4;
      pos[i * 3 + 2] = (Math.random() - 0.5) * 4 - 0.5;
      spd[i] = 0.006 + Math.random() * 0.016;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));

    // Soft round sprite; square points read as compression artefacts.
    const sc = document.createElement('canvas');
    sc.width = sc.height = 64;
    const sctx = sc.getContext('2d')!;
    const rg = sctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    rg.addColorStop(0, 'rgba(255,255,255,1)');
    rg.addColorStop(0.35, 'rgba(255,255,255,0.5)');
    rg.addColorStop(1, 'rgba(255,255,255,0)');
    sctx.fillStyle = rg;
    sctx.fillRect(0, 0, 64, 64);
    const sprTex = new THREE.CanvasTexture(sc);

    const m = new THREE.PointsMaterial({
      color: 0xbfe8fa,
      size: 0.014,
      map: sprTex,
      transparent: true,
      opacity: 0.35,
      depthWrite: false,
      sizeAttenuation: true,
      blending: THREE.AdditiveBlending,
    });
    snow = new THREE.Points(g, m);
    scene.add(snow);
    (snow as any).userData.spd = spd;
  }

  /* ── Model ── */
  const TARGET_LEN = 1.6;
  let model: THREE_NS.Mesh | null = null;
  let hullRadius = 0.1;
  let modelBaseY = 0;

  type Anchor = { local: THREE_NS.Vector3; normal: THREE_NS.Vector3 };
  const anchors: Anchor[] = [];

  const draco = new DRACOLoader();
  draco.setDecoderPath('/draco/');
  const gltfLoader = new GLTFLoader();
  gltfLoader.setDRACOLoader(draco);

  gltfLoader.load(
    '/fullassy0.5.glb',
    (gltf) => {
      let mesh: THREE_NS.Mesh | null = null;
      gltf.scene.traverse((o) => {
        if ((o as THREE_NS.Mesh).isMesh && !mesh) mesh = o as THREE_NS.Mesh;
      });
      if (!mesh) return;

      const geo = (mesh as THREE_NS.Mesh).geometry as THREE_NS.BufferGeometry;
      if (!geo.attributes.normal) geo.computeVertexNormals();
      geo.computeBoundingBox();
      const box = geo.boundingBox!;
      const size = new THREE.Vector3();
      box.getSize(size);
      const center = new THREE.Vector3();
      box.getCenter(center);

      const scale = TARGET_LEN / size.x;
      hullRadius = (size.z / 2) * scale;

      const material = new THREE.MeshStandardMaterial({
        color: 0x7d8996,
        roughness: 0.44,
        metalness: 0.55,
        envMapIntensity: 1.0,
      });

      model = new THREE.Mesh(geo, material);
      model.scale.setScalar(scale);
      // Centre on length and width; sit the hull axis on y = 0 so the mast
      // reads as "up" instead of the bounding box dragging the hull down.
      model.position.set(
        -center.x * scale,
        -(box.min.y * scale + hullRadius),
        -center.z * scale,
      );
      modelBaseY = model.position.y;
      scene.add(model);

      // Anchors in the mesh's own units, converted through the same transform.
      const inv = 1 / scale;
      const hullAxisLocal = box.min.y + hullRadius * inv;
      const mk = (lx: number, ly: number, lz: number, n: THREE_NS.Vector3) => ({
        local: new THREE.Vector3(lx, ly, lz),
        normal: n.normalize(),
      });
      const L = size.x;
      anchors.push(
        // upper deck, just aft of the mast, on the top surface
        mk(center.x - L * 0.06, hullAxisLocal + hullRadius * inv * 1.35, 0, new THREE.Vector3(0, 1, 0.35)),
        // mast tip
        mk(box.min.x + L * 0.117, box.max.y * 0.96, 0, new THREE.Vector3(0, 1, 0.5)),
        // lower bay, underside
        mk(center.x - L * 0.05, hullAxisLocal - hullRadius * inv * 1.0, 0, new THREE.Vector3(0, -1, 0.35)),
      );

      loaderEl.classList.add('done');
      canvas.classList.add('ready');
      onScroll();
    },
    (evt) => {
      if (evt.lengthComputable) {
        const pct = Math.round((evt.loaded / evt.total) * 100);
        (loaderFill as HTMLElement).style.width = pct + '%';
      }
    },
    () => {
      loaderEl.textContent = 'Model unavailable';
    },
  );

  /* ── Camera choreography ── */
  type Step = { p: [number, number, number]; t: [number, number, number] };
  const steps: Step[] = [
    { p: [0.62, 0.40, 2.55], t: [0.00, 0.00, 0] },   // 0 establishing, three-quarter
    { p: [0.18, 0.74, 1.30], t: [-0.10, 0.05, 0] },  // 1 push to upper deck
    { p: [0.18, 0.74, 1.30], t: [-0.10, 0.05, 0] },  // 2 hold
    { p: [-0.55, 0.34, 2.5], t: [0.00, 0.00, 0] },   // 3 pull out, other shoulder
    { p: [-0.88, 0.44, 0.92], t: [-0.60, 0.24, 0] }, // 4 push to mast
    { p: [-0.88, 0.44, 0.92], t: [-0.60, 0.24, 0] }, // 5 hold
    { p: [0.40, 0.30, 2.5], t: [0.00, 0.00, 0] },    // 6 pull out
    { p: [0.14, -0.66, 1.28], t: [-0.08, -0.08, 0] },// 7 drop under the hull
    { p: [0.14, -0.66, 1.28], t: [-0.08, -0.08, 0] },// 8 hold
    { p: [0.00, 0.06, 2.45], t: [0.00, 0.00, 0] },   // 9 settle to profile
  ];

  // Transitions get slightly more scroll than holds so nothing feels rushed.
  const stepTimes = [0, 0.1127, 0.2206, 0.3333, 0.446, 0.5539, 0.6666, 0.7794, 0.8872, 1.0];

  // Each callout owns the middle of its hold window, not its end frame.
  const CALLOUT_AT = [1.5, 4.5, 7.5];

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  let rawStep = 0;

  function scrollToStep(s: number) {
    for (let i = 0; i < stepTimes.length - 1; i++) {
      if (s <= stepTimes[i + 1]) {
        const t = (s - stepTimes[i]) / (stepTimes[i + 1] - stepTimes[i]);
        return i + Math.min(Math.max(t, 0), 1);
      }
    }
    return stepTimes.length - 1;
  }

  // The keyframes are framed for a wide viewport. On narrower or taller ones
  // the horizontal field of view shrinks, so back the camera off to match.
  // Phones also get a wider lens, so the correction does not have to push the
  // vehicle so far away that it becomes a speck.
  const AR_REF = 1.6;
  function distanceScale() {
    return Math.min(Math.max(AR_REF / camera.aspect, 1), isMobile() ? 1.7 : 2.6);
  }

  function applyStep(raw: number) {
    const last = steps.length - 1;
    const i = Math.min(Math.floor(raw), last - 1);
    const t = ease(Math.min(Math.max(raw - i, 0), 1));
    const a = steps[i];
    const b = steps[Math.min(i + 1, last)];
    camLookTarget.set(lerp(a.t[0], b.t[0], t), lerp(a.t[1], b.t[1], t), lerp(a.t[2], b.t[2], t));
    camPosTarget
      .set(lerp(a.p[0], b.p[0], t), lerp(a.p[1], b.p[1], t), lerp(a.p[2], b.p[2], t))
      .sub(camLookTarget)
      .multiplyScalar(distanceScale())
      .add(camLookTarget);
  }

  const driver = document.querySelector('.scroll-driver') as HTMLElement;
  const viewerEl = document.getElementById('viewer')!;

  function onScroll() {
    if (!driver) return;
    const driverTop = driver.getBoundingClientRect().top + window.scrollY - window.innerHeight;
    const scrolled = Math.min(Math.max((window.scrollY - driverTop) / driver.offsetHeight, 0), 1);
    rawStep = scrollToStep(scrolled);
    applyStep(rawStep);
    (vpFill as HTMLElement).style.width = (scrolled * 100).toFixed(1) + '%';
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  /* ── Callout placement ── */
  const wv = new THREE.Vector3();
  const camDir = new THREE.Vector3();
  const nrm = new THREE.Vector3();

  function layout() {
    if (!model || anchors.length === 0) return;
    const mobile = isMobile();
    const offX = Math.min(300, W * 0.2);
    const offY = H * 0.21;

    camera.getWorldDirection(camDir);

    anchors.forEach((a, i) => {
      const card = cardEls[i];
      const dist = Math.abs(rawStep - CALLOUT_AT[i]);
      // Fully open through the hold, faded out before the camera moves on.
      let op = Math.min(Math.max(1 - (dist - 0.4) / 0.5, 0), 1);

      // Dim when the anchored face has turned away from the camera.
      nrm.copy(a.normal).transformDirection(model!.matrixWorld);
      const facing = -nrm.dot(camDir);
      op *= Math.min(Math.max((facing + 0.25) / 0.6, 0), 1);

      groupEls[i].style.opacity = String(op);
      card.style.opacity = String(op);
      if (op < 0.01) return;

      wv.copy(a.local);
      model!.localToWorld(wv);
      const ndc = wv.clone().project(camera);
      const sx = ((ndc.x + 1) / 2) * W;
      const sy = ((-ndc.y + 1) / 2) * H;

      dotEls[i].setAttribute('cx', sx.toFixed(1));
      dotEls[i].setAttribute('cy', sy.toFixed(1));
      haloEls[i].setAttribute('cx', sx.toFixed(1));
      haloEls[i].setAttribute('cy', sy.toFixed(1));
      haloEls[i].setAttribute('r', String(9 + Math.sin(performance.now() / 620) * 3));

      if (mobile) return;

      const side = card.dataset.side;
      const dirX = side === 'right' ? 1 : -1;
      // Callout 3 hangs below the hull; the other two float above it.
      const dirY = i === 2 ? 1 : -1;

      const cardW = card.offsetWidth || 320;
      const cardH = card.offsetHeight || 160;
      const pad = 40;
      const gap = 18;

      // Horizontal rail height, then the card sits clear of it so the text
      // never lands on top of the hull.
      let ly = sy + offY * dirY;
      ly = Math.min(
        Math.max(ly, dirY < 0 ? pad + cardH + gap : pad),
        dirY < 0 ? H - pad : H - cardH - gap - pad,
      );

      let px = sx + offX * dirX;
      if (side === 'right') px = Math.min(px, W - cardW - pad);
      else px = Math.max(px, cardW + pad);

      const py = dirY < 0 ? ly - gap : ly + gap;

      lineEls[i].setAttribute(
        'd',
        `M ${sx.toFixed(1)} ${sy.toFixed(1)} L ${sx.toFixed(1)} ${ly.toFixed(1)} L ${px.toFixed(1)} ${ly.toFixed(1)}`,
      );

      card.style.transform =
        `translate(${px.toFixed(1)}px, ${py.toFixed(1)}px)` +
        (side === 'left' ? ' translateX(-100%)' : '') +
        (dirY < 0 ? ' translateY(-100%)' : '');
    });
  }

  /* ── Loop ── */
  let prev = performance.now();
  function animate(now: number) {
    requestAnimationFrame(animate);
    const dt = Math.min((now - prev) / 1000, 0.05);
    prev = now;

    // Critically damped follow so scrubbing feels weighted, not snappy.
    const k = 1 - Math.exp(-6.5 * dt);
    camPos.lerp(camPosTarget, k);
    camLook.lerp(camLookTarget, k);
    camera.position.copy(camPos);
    camera.lookAt(camLook);

    if (model && !reduced) {
      const t = now / 1000;
      model.position.y = modelBaseY + Math.sin(t * 0.55) * 0.008;
      model.rotation.z = Math.sin(t * 0.4) * 0.007;
      model.rotation.y = Math.sin(t * 0.28) * 0.012;
    }

    if (snow) {
      const p = snow.geometry.attributes.position as THREE_NS.BufferAttribute;
      const spd = (snow as any).userData.spd as Float32Array;
      for (let i = 0; i < spd.length; i++) {
        let y = p.getY(i) + spd[i] * dt;
        if (y > 2) y = -2;
        p.setY(i, y);
      }
      p.needsUpdate = true;
    }

    renderer.render(scene, camera);
    layout();
  }
  requestAnimationFrame(animate);

  function resize() {
    W = window.innerWidth;
    H = viewerEl.clientHeight || window.innerHeight;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile() ? 1.5 : 2));
    renderer.setSize(W, H);
    camera.aspect = W / H;
    camera.fov = isMobile() ? 52 : 38;
    camera.updateProjectionMatrix();
    svgEl.setAttribute('viewBox', `0 0 ${W} ${H}`);
    onScroll();
  }
  window.addEventListener('resize', resize);
  resize();
  }

  if (use3D) init3D();

  /* ───────────────────────── Stat counters ───────────────────────── */
  const statEls = Array.from(document.querySelectorAll('.stat-val')) as HTMLElement[];
  const countObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        countObs.unobserve(el);
        const target = Number(el.dataset.count || 0);
        const pre = el.dataset.prefix || '';
        const suf = el.dataset.suffix || '';
        if (reduced) {
          el.textContent = pre + target + suf;
          return;
        }
        const dur = 1100;
        const t0 = performance.now();
        const tick = (n: number) => {
          const p = Math.min((n - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = pre + Math.round(target * eased) + suf;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    },
    { threshold: 0.6 },
  );
  statEls.forEach((el) => countObs.observe(el));

  /* ───────────────────────── Section reveals ───────────────────────── */
  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          revealObs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  /* ───────────────────────── CFD scrubber ───────────────────────── */
  const FRAMES = 33;
  const COLS = 6;
  const ROWS = 6;
  const sprite = document.getElementById('cfd-sprite')!;
  const cfdFig = document.getElementById('cfd')!;
  const cfdTime = document.getElementById('cfd-time')!;
  const cfdFill = document.getElementById('cfd-fill')!;

  function setFrame(i: number) {
    const f = Math.min(Math.max(Math.round(i), 0), FRAMES - 1);
    const col = f % COLS;
    const row = Math.floor(f / COLS);
    sprite.style.backgroundPosition = `${(col * 100) / (COLS - 1)}% ${(row * 100) / (ROWS - 1)}%`;
    cfdTime.textContent = `Frame ${f + 1} / ${FRAMES}`;
    (cfdFill as HTMLElement).style.width = ((f / (FRAMES - 1)) * 100).toFixed(1) + '%';
  }

  if (reduced) {
    setFrame(FRAMES - 1);
  } else {
    setFrame(0);
    const onCfdScroll = () => {
      const r = cfdFig.getBoundingClientRect();
      // Play across the window from the figure entering to fully passed.
      const span = window.innerHeight * 0.75 + r.height;
      const p = Math.min(Math.max((window.innerHeight - r.top) / span, 0), 1);
      setFrame(p * (FRAMES - 1));
    };
    window.addEventListener('scroll', onCfdScroll, { passive: true });
    onCfdScroll();
  }

  /* ───────────────────────── Back link contrast ───────────────────────── */
  const backLink = document.getElementById('back-link')!;
  const mainEl = document.querySelector('main')!;
  const themeObs = new IntersectionObserver(
    () => {
      const y = mainEl.getBoundingClientRect().top;
      backLink.style.mixBlendMode = y < 60 ? 'normal' : 'difference';
      backLink.style.color = y < 60 ? '#aaa' : 'rgba(255,255,255,0.5)';
    },
    { threshold: [0, 0.01, 0.5, 1] },
  );
  themeObs.observe(mainEl);
</script>
